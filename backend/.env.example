# Environment variables for Carboniq AI Backend
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Flask secret key (used for session security)
SECRET_KEY=change-this-to-a-long-random-string

# JWT signing key
JWT_SECRET_KEY=change-this-to-another-long-random-string

# Path to the emission factors CSV (relative to project root)
# Default: data/emission_factors.csv
EMISSION_FACTORS_CSV=data/emission_factors.csv

# SQLite database URI
# Default: sqlite:///carboniq.db  (created inside backend/)
DATABASE_URI=sqlite:///carboniq.db

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1

# Future Lyzr AI integration (optional – leave blank to skip)
# LYZR_API_KEY=your-lyzr-api-key-here
# LYZR_AGENT_ID=your-lyzr-agent-id-here
