# =============================================================================
# Environment variables for Carboniq AI Backend
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# Flask secret key (used for session security - min 32 characters in production)
SECRET_KEY=change-this-to-a-long-random-string-min-32-chars

# JWT signing key (used for access tokens - min 32 characters in production)
JWT_SECRET_KEY=change-this-to-another-long-random-string-min-32-chars

# Path to the emission factors CSV (relative to project root or absolute)
# Default: data/emission_factors.csv
EMISSION_FACTORS_CSV=data/emission_factors.csv

# SQLite database URI
# Default: sqlite:///carboniq.db  (created inside backend/)
DATABASE_URI=sqlite:///carboniq.db

# Flask environment & Debug
FLASK_ENV=development
FLASK_DEBUG=1

# CORS allowed origins (default: * in dev, configure specific origin in prod)
CORS_ORIGINS=*

# Optional: Lyzr AI Agent Integration
# LYZR_API_KEY=your-lyzr-api-key-here
# LYZR_AGENT_ID=your-lyzr-agent-id-here
# LYZR_ENDPOINT=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
# LYZR_TIMEOUT_SECONDS=20
